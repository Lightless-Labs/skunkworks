+def passing_count(candidate: dict) -> int:
+    return sum(test.get("outcome") == "pass" for test in candidate.get("verify", {}).get("tests", []))
+
+
+def render_repair_verify(result: dict) -> str:
+    lines = [
+        f"[pass] {test.get('name', test.get('index', '?'))}"
+        for test in result.get("tests", [])
+        if test.get("outcome") == "pass"
+    ]
+    failures = render_verify(result)
+    if failures != "No passing visible tests were reported.":
+        lines.append(failures)
+    return "\n".join(lines) or "No visible verifier results were reported."
+
+
