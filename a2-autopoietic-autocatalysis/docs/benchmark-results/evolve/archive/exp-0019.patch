+                and state.get("budget", {}).get("agent_calls_left", 0) > 0):
+            passed_candidate = candidates[first_pass_position]
+            return {"agent": {
+                "base": passed_candidate["index"],
+                "prompt": state["problem_statement"] + AUDIT_HEADER,
+                "effort": effort,
+            }}
+        best_passing = max(passing, key=lambda candidate: candidate["index"])
+        return {"submit": {"candidate": best_passing["index"]}}
     if state.get("budget", {}).get("agent_calls_left", 0) > 0:
