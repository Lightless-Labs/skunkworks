--- a/genome/policy.py
+++ b/genome/policy.py
@@ -12,6 +12,11 @@ FEEDBACK_HEADER = (
     "\n\n---\nA previous attempt at this task was rejected by the verifier. "
     "Start again from the original code. Verifier output from that attempt:\n"
 )
+AUDIT_HEADER = (
+    "\n\n---\nThis implementation passed all visible checks after earlier attempts failed. "
+    "Review it against the full task requirements and likely edge cases beyond the visible checks. "
+    "Improve it if needed while preserving correct behavior, and return a complete implementation.\n"
+)
 
 
 def configured_effort() -> str:
