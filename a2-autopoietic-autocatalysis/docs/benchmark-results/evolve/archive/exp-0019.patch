     if not candidates:
         return {"agent": {"base": "fresh", "prompt": state["problem_statement"], "effort": effort}}
     last = candidates[-1]
-    if last.get("verify", {}).get("passed"):
-        return {"submit": {"candidate": last["index"]}}
+    passing = [candidate for candidate in candidates if candidate.get("verify", {}).get("passed")]
+    if passing:
+        first_pass_position = next(
+            position for position, candidate in enumerate(candidates)
+            if candidate.get("verify", {}).get("passed")
+        )
+        earlier_feedback = any(
+            render_verify(candidate.get("verify", {})) != "No passing visible tests were reported."
+            for candidate in candidates[:first_pass_position]
+        )
+        if (first_pass_position > 0 and first_pass_position == len(candidates) - 1
