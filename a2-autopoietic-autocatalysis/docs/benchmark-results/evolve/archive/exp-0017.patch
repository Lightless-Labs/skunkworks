+def render_passing_checks(candidate: dict) -> str:
+    tests = candidate.get("verify", {}).get("tests", [])
+    names = [
+        str(test.get("name", test.get("index", "?")))
+        for test in tests
+        if test.get("outcome") == "pass"
+    ]
+    if not names:
+        return ""
+    return (
+        "Visible checks already passing on the strongest prior candidate "
+        "(preserve these behaviors):\n" + "\n".join(names) + "\n\n"
+    )
