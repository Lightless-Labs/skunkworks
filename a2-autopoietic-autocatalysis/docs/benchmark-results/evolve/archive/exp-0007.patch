+def render_history(candidates: list[dict]) -> str:
+    outcomes: dict[str, dict] = {}
+    extras = []
+    for candidate in candidates:
+        candidate_index = candidate.get("index", "?")
+        verify = candidate.get("verify", {})
+        for test in verify.get("tests", []):
+            name = test.get("name")
+            test_index = test.get("index")
+            key = f"name:{name}" if name is not None else f"index:{test_index}"
+            record = outcomes.setdefault(key, {
+                "label": name if name is not None else test_index if test_index is not None else "?",
+                "observations": [],
+            })
+            record["observations"].append({
+                "candidate": candidate_index,
+                "outcome": str(test.get("outcome", "unknown")),
+                "message": str(test.get("message", "")).strip(),
+            })
+        for reason in verify.get("rejected", []):
+            extras.append(f"[rejected] candidate {candidate_index}: {reason}")
+        if verify.get("error"):
+            extras.append(f"[error] candidate {candidate_index}: {verify['error']}")
+
+    groups = {"Repeated failures": [], "Mixed outcomes": [], "Other failures": []}
+    for record in outcomes.values():
+        failures = [item for item in record["observations"] if item["outcome"] != "pass"]
+        if not failures:
+            continue
+        passes = [item for item in record["observations"] if item["outcome"] == "pass"]
+        if len(failures) > 1:
+            group = "Repeated failures"
+        elif passes:
+            group = "Mixed outcomes"
+        else:
+            group = "Other failures"
+        failed_at = ", ".join(str(item["candidate"]) for item in failures)
+        line = f"{record['label']}: failed on candidate(s) {failed_at}"
+        if passes:
+            passed_at = ", ".join(str(item["candidate"]) for item in passes)
+            line += f"; passed on candidate(s) {passed_at}"
+        messages = list(dict.fromkeys(item["message"] for item in failures if item["message"]))
+        if messages:
+            line += "; failure details: " + " | ".join(messages)
+        groups[group].append(line)
+
+    sections = []
+    for title, lines in groups.items():
+        if lines:
+            sections.append(f"{title}:\n" + "\n".join(f"- {line}" for line in lines))
+    if extras:
+        sections.append("Verifier-level failures:\n" + "\n".join(f"- {line}" for line in extras))
+    return "\n\n".join(sections) or "No failing visible checks were reported."
+
